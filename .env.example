# ═══════════════════════════════════════════════════════════════════════════════
# CivicPulse Nexus — Environment Variables
#
# SETUP:
#   cp .env.example .env
#   Fill in real values in .env
#   NEVER commit .env to git (it's in .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=civicpulse
DB_PASSWORD=your_strong_db_password_here

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_CLIENT_SECRET=jN2aoubARsn0k9sdqRumX7Mxb4CJ2NMY

# ── Spring profiles ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Mail (for Milestone 4 email notifications) ────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
