FROM openjdk:25-ea-slim-bullseye

RUN addgroup -S civicpulse && adduser -S civicpulse -G civicpulse
USER civicpulse

WORKDIR /app
RUN mkdir -p /app/uploads

COPY target/*.jar app.jar

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -q --spider http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

EXPOSE ${SERVER_PORT:-8080}

ENTRYPOINT ["java", "-Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod}", "-jar", "app.jar"]